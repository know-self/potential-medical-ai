# Unified CLI defaults. CLI flags override these values.
PMAI_HOST=127.0.0.1
PMAI_PUBLIC_HOST=localhost
PMAI_WEB_PORT=3000
PMAI_HISTORY_PORT=3001
PMAI_ENV_FILE=.env

# Frontend talks only to the chat gateway. Never expose model, user-data, reviewer, or source credentials as VITE_* variables.
# The PMAI CLI overrides this to same-origin and configures the Vite proxy automatically.
VITE_MEDICAL_API_URL=http://localhost:8787

# Chat gateway
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
KNOWLEDGE_PLANE_URL=http://127.0.0.1:8790
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-12b-it:free
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=Potential Medical AI
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=80
UPSTREAM_TIMEOUT_MS=20000

# Independent knowledge control plane
KNOWLEDGE_PLANE_PORT=8790
KNOWLEDGE_PLANE_HOST=127.0.0.1
KNOWLEDGE_ALLOWED_HOSTS=127.0.0.1,localhost
API_ADMIN_TOKEN=replace-with-a-long-random-administrator-secret
CLINICAL_REVIEWER_TOKEN=replace-with-a-separate-long-reviewer-secret
CLINICAL_APPROVALS_REQUIRED=2
CLINICAL_REVIEW_MAX_AGE_HOURS=72
SYNC_ENABLED=true
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=360
MAX_ITEMS_PER_SOURCE=20
MEDICAL_DATA_DIR=server/data
MEDICAL_KNOWLEDGE_FILE=server/data/knowledge.json
MEDICAL_SOURCE_STATE_FILE=server/data/source-state.json
CLINICAL_REVIEW_STATE_FILE=server/data/clinical-review.json
GOVERNANCE_AUDIT_FILE=server/data/governance-audit.jsonl
SOURCE_REGISTRY_FILE=server/data/source-registry.json
INCIDENT_FILE=server/data/incidents.json
METRICS_FILE=server/data/metrics.json

# Fail closed means medical answers stop when required sources are stale or never synchronized.
KNOWLEDGE_FAIL_CLOSED=true
KNOWLEDGE_DEFAULT_MAX_AGE_MINUTES=1440
REQUIRED_KNOWLEDGE_SOURCES=pubmed,clinicaltrials.gov,openfda-drug-enforcement,cdc-content-services
KNOWLEDGE_SOURCE_MAX_AGE_JSON={"openfda-drug-enforcement":360,"vietnam-moh":720,"who-icd-11":44640}
KNOWLEDGE_REQUEST_TIMEOUT_MS=10000

# Source connectors
MEDICAL_SYNC_TOPICS=diabetes mellitus,hypertension,chronic kidney disease,heart failure,asthma,cancer,stroke,depression,infectious disease
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=potential-medical-ai
OPENFDA_API_KEY=
CDC_TOPICS=diabetes,heart disease,cancer,stroke
DAILYMED_SET_IDS=
WHO_FEED_URLS=
NICE_FEED_URLS=
VIETNAM_MOH_FEED_URLS=
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE=2026-01
WHO_ICD_LANGUAGE=en
SNOMED_FHIR_BASE_URL=
SNOMED_BEARER_TOKEN=

# Privacy control plane. Use independent, high-entropy secrets in production.
USER_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
USER_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# One-time rotation command uses these temporary variables, then unset them.
OLD_USER_DATA_ENCRYPTION_KEY=
NEW_USER_DATA_ENCRYPTION_KEY=
USER_BOOTSTRAP_TOKEN=replace-with-an-operator-or-identity-provider-secret
USER_SESSION_HOURS=12
USER_DATA_RETENTION_DAYS=90
USER_DATA_FILE=server/data/user-data.enc.json
PRIVACY_AUDIT_FILE=server/data/privacy-audit.jsonl
SHARE_DATA_FILE=server/data/shares.enc.json
SHARE_DEFAULT_EXPIRY_MINUTES=60
SHARE_MAX_EXPIRY_MINUTES=10080

# Secure upload and extraction
UPLOAD_DIRECTORY=server/data/uploads
UPLOAD_METADATA_FILE=server/data/uploads.enc.json
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=text/plain,application/json,application/pdf,image/png,image/jpeg
UPLOAD_RETENTION_DAYS=30
UPLOAD_REQUIRE_MALWARE_SCAN=false
MALWARE_SCANNER_URL=
DOCUMENT_EXTRACTOR_URL=
MEDICAL_IMAGE_ANALYSIS_ENABLED=false

# Per-tenant capacity and grounded model-provider circuit breakers
TENANT_REQUESTS_PER_HOUR=120
TENANT_CHARACTERS_PER_DAY=500000
MODEL_CACHE_TTL_MINUTES=30
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RESET_SECONDS=60

# MCP stdio is read-only by default. Enable sync only in a trusted operator runtime.
MCP_ALLOW_SYNC=false

# Authenticated remote MCP (Streamable HTTP). Keep disabled until deployed on a private network.
MCP_HTTP_ENABLED=false
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8791
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_HTTP_BEARER_TOKEN=replace-with-a-long-read-only-service-identity-token
MCP_HTTP_SYNC_BEARER_TOKEN=replace-with-a-separate-long-sync-service-token
MCP_HTTP_ALLOW_SYNC=false
