# Frontend talks only to the chat gateway. Never expose model or source credentials as VITE_* variables.
VITE_MEDICAL_API_URL=http://localhost:8787

# Chat gateway
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
KNOWLEDGE_PLANE_URL=http://127.0.0.1:8790
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-12b-it:free
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=Potential Medical AI
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=80
UPSTREAM_TIMEOUT_MS=20000

# Independent knowledge control plane
KNOWLEDGE_PLANE_PORT=8790
KNOWLEDGE_PLANE_HOST=127.0.0.1
KNOWLEDGE_ALLOWED_HOSTS=127.0.0.1,localhost
API_ADMIN_TOKEN=replace-with-a-long-random-secret
SYNC_ENABLED=true
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=360
MAX_ITEMS_PER_SOURCE=20
MEDICAL_DATA_DIR=server/data
MEDICAL_KNOWLEDGE_FILE=server/data/knowledge.json
MEDICAL_SOURCE_STATE_FILE=server/data/source-state.json

# Fail closed means medical answers stop when required sources are stale or never synchronized.
KNOWLEDGE_FAIL_CLOSED=true
KNOWLEDGE_DEFAULT_MAX_AGE_MINUTES=1440
REQUIRED_KNOWLEDGE_SOURCES=pubmed,clinicaltrials.gov,openfda-drug-enforcement,cdc-content-services
# Optional per-source overrides in minutes, as JSON.
KNOWLEDGE_SOURCE_MAX_AGE_JSON={"openfda-drug-enforcement":360,"vietnam-moh":720,"who-icd-11":44640}
KNOWLEDGE_REQUEST_TIMEOUT_MS=10000

# Source connectors
MEDICAL_SYNC_TOPICS=diabetes mellitus,hypertension,chronic kidney disease,heart failure,asthma,cancer,stroke,depression,infectious disease
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=potential-medical-ai
OPENFDA_API_KEY=
CDC_TOPICS=diabetes,heart disease,cancer,stroke
DAILYMED_SET_IDS=
WHO_FEED_URLS=
NICE_FEED_URLS=
VIETNAM_MOH_FEED_URLS=
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE=2026-01
WHO_ICD_LANGUAGE=en

# MCP is read-only by default. Enable sync only in a trusted operator runtime.
MCP_ALLOW_SYNC=false
