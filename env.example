# Frontend: leave blank in local development to use the Vite /api proxy.
VITE_MEDICAL_API_URL=
VITE_API_BASE_URL=http://localhost:3001
VITE_OPENROUTER_MODEL=google/gemma-3-12b-it:free
VITE_GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# Backend model credentials. Never prefix secrets with VITE_.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
OPENROUTER_MODEL=google/gemma-3-12b-it:free
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=Potential Medical AI

# Medical API security and runtime.
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
API_ADMIN_TOKEN=replace_with_a_long_random_token
RATE_LIMIT_MAX=80
RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=20000

# Knowledge synchronization.
SYNC_ENABLED=true
SYNC_ON_START=false
SYNC_INTERVAL_MINUTES=360
MAX_ITEMS_PER_SOURCE=20
MEDICAL_SYNC_TOPICS=diabetes mellitus,hypertension,chronic kidney disease,heart failure,asthma,COPD,stroke,cancer,depression,infectious disease

# Optional official source credentials.
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=potential-medical-ai
OPENFDA_API_KEY=
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE=2026-01
WHO_ICD_LANGUAGE=en

# DailyMed full-label synchronization requires explicit SET IDs.
DAILYMED_SET_IDS=

# CDC query topics.
CDC_TOPICS=diabetes,heart disease,cancer,stroke

# Configurable RSS/Atom feeds. Add only official, licensed sources.
WHO_FEED_URLS=
NICE_FEED_URLS=
VIETNAM_MOH_FEED_URLS=

# Optional storage paths. Defaults to server/data/*.json.
MEDICAL_DATA_DIR=
MEDICAL_KNOWLEDGE_FILE=
MEDICAL_SOURCE_STATE_FILE=
